/* Medium Mobile - 480px and below */
@media (max-width: 480px) {
  .attack-content {
    width: 90%;
    padding: 6px;
  }

  .attack-content h1 {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .attack-planner {
    gap: 10px;
  }

  .attack-planner .attack-form {
    gap: 10px;
  }

  .attack-planner .form-row {
    gap: 6px;
  }

  .attack-planner .form-row:nth-child(3) {
    align-items: center;
    justify-content: center;
  }

  .attack-planner .form-row:nth-child(3) .form-group {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .attack-planner .column-group {
    gap: 6px;
  }

  .attack-planner .village-input,
  .attack-planner .date-input-wrapper {
    width: 120px;
    height: 30px;
    font-size: 11px;
  }

  .attack-planner .time-label {
    font-size: 11px;
    margin-right: 4px;
  }

  .attack-planner .time-inputs input {
    width: 45px;
    height: 30px;
    font-size: 11px;
    padding: 3px;
  }

  .attack-planner .type-buttons-grid {
    gap: 6px;
    max-width: 180px;
  }

  .attack-planner .type-btn {
    padding: 5px 6px;
    font-size: 10px;
    height: 30px;
    min-width: 70px;
  }

  .attack-planner .form-buttons {
    gap: 6px;
  }

  .attack-planner .link-input {
    width: 100px;
    height: 30px;
    font-size: 11px;
    padding: 5px 8px;
  }

  .attack-planner .add-attack-btn,
  .attack-planner .edit-btn {
    padding: 5px 10px;
    font-size: 11px;
    width: 90px;
    height: 30px;
  }

  .attack-planner .attacks-table table {
    min-width: 500px;
    font-size: 10px;
  }

  .attack-planner .attacks-table th,
  .attack-planner .attacks-table td {
    padding: 3px 1px;
    font-size: 10px;
  }

  .attack-planner .attacks-table .action-buttons button {
    padding: 2px 4px;
    font-size: 9px;
    min-width: 30px;
  }
}

/* Small Mobile - 360px and below */
@media (max-width: 360px) {
  .attack-content {
    width: 90%;
    padding: 4px;
  }

  .attack-content h1 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .attack-planner {
    gap: 8px;
  }

  .attack-planner .attack-form {
    gap: 8px;
  }

  .attack-planner .form-row {
    gap: 4px;
  }

  .attack-planner .form-row:nth-child(3) {
    align-items: center;
    justify-content: center;
  }

  .attack-planner .form-row:nth-child(3) .form-group {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .attack-planner .column-group {
    gap: 4px;
  }

  .attack-planner .village-input,
  .attack-planner .date-input-wrapper {
    width: 100px;
    height: 28px;
    font-size: 10px;
  }

  .attack-planner .time-label {
    font-size: 10px;
    margin-right: 3px;
  }

  .attack-planner .time-inputs input {
    width: 40px;
    height: 28px;
    font-size: 10px;
    padding: 2px;
  }

  .attack-planner .type-buttons-grid {
    gap: 4px;
    max-width: 160px;
  }

  .attack-planner .type-btn {
    padding: 4px 5px;
    font-size: 9px;
    height: 28px;
    min-width: 60px;
  }

  .attack-planner .form-buttons {
    gap: 4px;
  }

  .attack-planner .link-input {
    width: 80px;
    height: 28px;
    font-size: 10px;
    padding: 4px 6px;
  }

  .attack-planner .add-attack-btn,
  .attack-planner .edit-btn {
    padding: 4px 8px;
    font-size: 10px;
    width: 80px;
    height: 28px;
  }

  .attack-planner .attacks-table table {
    min-width: 450px;
    font-size: 9px;
  }

  .attack-planner .attacks-table th,
  .attack-planner .attacks-table td {
    padding: 2px 1px;
    font-size: 9px;
  }

  .attack-planner .attacks-table .action-buttons button {
    padding: 2px 3px;
    font-size: 8px;
    min-width: 25px;
  }
}

/* Ultra Small Mobile - 320px and below */
@media (max-width: 320px) {
  .attack-content {
