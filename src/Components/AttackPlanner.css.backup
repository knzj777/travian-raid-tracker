    font-size: 9px;
    margin-right: 2px;
  }

  .attack-planner .time-inputs input {
    width: 35px;
    height: 26px;
    font-size: 9px;
    padding: 1px;
  }

  .attack-planner .type-buttons-grid {
    gap: 3px;
    max-width: 140px;
  }

  .attack-planner .type-btn {
    padding: 3px 4px;
    font-size: 8px;
    height: 26px;
    min-width: 50px;
  }

  .attack-planner .form-buttons {
    gap: 3px;
  }

  .attack-planner .link-input {
    width: 70px;
    height: 26px;
    font-size: 9px;
    padding: 3px 5px;
  }

  .attack-planner .add-attack-btn,
  .attack-planner .edit-btn {
    padding: 3px 6px;
    font-size: 9px;
    width: 70px;
    height: 26px;
  }

  .attack-planner .attacks-table table {
    min-width: 400px;
    font-size: 8px;
  }

  .attack-planner .attacks-table th,
  .attack-planner .attacks-table td {
    padding: 1px;
    font-size: 8px;
  }

  .attack-planner .attacks-table .action-buttons button {
    padding: 1px 2px;
    font-size: 7px;
    min-width: 20px;
  }
}
